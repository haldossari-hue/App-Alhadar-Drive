# ===== أساسي =====
NODE_ENV=production
PORT=3000
# الرابط العام (لازم HTTPS في الإنتاج — الإشعارات والموقع والدفع تحتاجه)
PUBLIC_URL=https://alhadar.example.sa
# مفتاح سري طويل وعشوائي: openssl rand -hex 32
APP_SECRET=
DATA_DIR=./data
# رمز الإدارة الأولي (يستخدم فقط إذا ما فيه رمز محفوظ — غيّره من الإعدادات بعد أول دخول)
INITIAL_ADMIN_PIN=1234

# ===== رسائل SMS لرمز التحقق: console (تطوير) | unifonic | taqnyat =====
SMS_PROVIDER=console
SMS_SENDER=AlHadar
UNIFONIC_APP_SID=
TAQNYAT_TOKEN=

# ===== بوابة الدفع (مدى / Apple Pay / STC Pay / بطاقات): اتركه فاضي لإخفائها، أو moyasar =====
PAYMENT_PROVIDER=
MOYASAR_SECRET_KEY=

# ===== إشعارات Push (اختياري: إذا تُركت فاضية تتولد تلقائياً وتُحفظ بالقاعدة) =====
VAPID_SUBJECT=mailto:admin@alhadar.example.sa
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
