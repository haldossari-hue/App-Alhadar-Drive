{
  "name": "alhadar-drive",
  "version": "1.0.0",
  "private": true,
  "description": "الهدار درايف — تطبيق توصيل محلي لمدينة الهدار (خادم + PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "import:artifact": "node --disable-warning=ExperimentalWarning scripts/import-artifact-export.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/unit/*.test.js'",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "leaflet": "^1.9.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
